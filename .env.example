# Скопируйте в .env и заполните: cp .env.example .env

# ===== Обязательные =====

# IMAP-сервер почты. Примеры: imap.rambler.ru, imap.gmail.com,
# imap.yandex.ru, imap.mail.ru, outlook.office365.com
EMAIL_SERVER=imap.example.com

# Логин и пароль ящика. Для большинства сервисов нужен пароль приложения.
EMAIL=user@example.com
PASSWORD=app_password

# Адреса отправителей писем с кодами, через запятую
ALLOWED_SENDERS=noreply@service-one.com,support@service-two.com

# Токен бота от @BotFather и ID чата или канала
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890

# ===== Необязательные (указаны значения по умолчанию) =====

# Шифрование: ssl (порт 993) или starttls (порт 143)
# IMAP_SECURITY=ssl
# IMAP_PORT=993

# Папка, в которой искать письма
# IMAP_FOLDER=INBOX

# Проверять получателя письма (To, Cc, Delivered-To), через запятую.
# Полезно, если в ящик приходят письма на несколько алиасов. Пусто — не проверять.
# ALLOWED_RECIPIENTS=

# Текст перед кодом в сообщении Telegram. Пусто — только код.
# MESSAGE_PREFIX=

# Длина кода и слова, рядом с которыми он ищется в первую очередь
# CODE_LENGTH=6
# CODE_KEYWORDS=код,code,пароль,password,otp

# Интервал проверки (с), максимальный возраст письма (мин), таймауты (с)
# POLL_INTERVAL=10
# MAX_EMAIL_AGE_MINUTES=15
# IMAP_TIMEOUT=30
# HTTP_TIMEOUT=10

# LOG_LEVEL=INFO
